# Core monitoring
PORT=8787
REGIONS=us
POLL_SECONDS=60
GEARBEACON_DATA_DIR=

# local, private, or proxy
GEARBEACON_ACCESS_MODE=local
GEARBEACON_BIND_HOST=127.0.0.1
GEARBEACON_PUBLIC_BASE_URL=
GEARBEACON_COOKIE_SECURE=0
GEARBEACON_ALLOWED_ORIGINS=

# First-run/recovery automation (prefer a password file)
GEARBEACON_SETUP_TOKEN=
GEARBEACON_OWNER_PASSWORD_FILE=
GEARBEACON_OWNER_PASSWORD=
GEARBEACON_RESET_OWNER_PASSWORD=0
GEARBEACON_SESSION_HOURS=168

# Backups, product history, and reliable delivery
GEARBEACON_BACKUP_INTERVAL_HOURS=24
GEARBEACON_BACKUP_RETENTION=10
GEARBEACON_HISTORY_RETENTION_DAYS=365
GEARBEACON_NOTIFICATION_MAX_ATTEMPTS=5
GEARBEACON_NOTIFICATION_GROUP_SECONDS=0
GEARBEACON_NOTIFICATION_COOLDOWN_MINUTES=30
GEARBEACON_TIME_ZONE=
GEARBEACON_QUIET_HOURS_ENABLED=0
GEARBEACON_QUIET_HOURS_START=22:00
GEARBEACON_QUIET_HOURS_END=07:00
GEARBEACON_DIGEST_ENABLED=0
GEARBEACON_DIGEST_TIME=09:00
GEARBEACON_ALERT_MONITOR_FAILURES=1
GEARBEACON_ALERT_NOTIFICATION_FAILURES=1
GEARBEACON_ALERT_BACKUP_FAILURES=1
GEARBEACON_ALERT_LOW_DISK=1

# ntfy
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Discord and Gotify
DISCORD_WEBHOOK_URL=
GOTIFY_BASE_URL=
GOTIFY_TOKEN=

# Generic webhook
GEARBEACON_WEBHOOK_URL=
GEARBEACON_WEBHOOK_TOKEN=
GEARBEACON_WEBHOOK_HMAC_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_STARTTLS=1
SMTP_REJECT_UNAUTHORIZED=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
GEARBEACON_EMAIL_DETAIL_LEVEL=standard
GEARBEACON_EMAIL_EMBED_IMAGES=1
GEARBEACON_EMAIL_EXPLAIN_REASON=1
GEARBEACON_EMAIL_PRICE_CALCULATIONS=1
GEARBEACON_EMAIL_DIGEST_MAX_ITEMS=12
GEARBEACON_EMAIL_SUBJECT_PREFIX=[GearBeacon]
GEARBEACON_EMAIL_THEME=auto

# Manual update channel and catalog safety
GEARBEACON_GITHUB_RELEASE_API=https://api.github.com/repos/alexphillips-dev/GearBeacon/releases/latest
GEARBEACON_UPDATE_MANIFEST_URL=
GEARBEACON_MIN_CATALOG_RATIO=0.55
GEARBEACON_STALE_AFTER_SECONDS=180
MOCK_MODE=0
