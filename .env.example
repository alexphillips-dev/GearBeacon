# GearBeacon V1.4 backend configuration
PORT=8787
REGION=us
POLL_SECONDS=60

# Optional server-side alert channels.
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=

# Optional Expo Push access token when enhanced push security is enabled.
EXPO_ACCESS_TOKEN=

# Persistent SQLite data. Usually leave blank to use the OS user-data folder.
GEARBEACON_DATA_DIR=

# GitHub Releases powers Settings > Check for updates by default.
# Set this to an empty value to disable GitHub checks, or override it with another API.
GEARBEACON_GITHUB_RELEASE_API=https://api.github.com/repos/alexphillips-dev/GearBeacon/releases/latest

# Optional custom release manifest/API. When set, it is tried before GitHub Releases.
GEARBEACON_UPDATE_MANIFEST_URL=

# Cloud/deployment metadata. V1.4 remains single-user/unauthenticated.
GEARBEACON_DEPLOYMENT=local
GEARBEACON_PUBLIC_BASE_URL=

# Monitor safety controls.
GEARBEACON_MIN_CATALOG_RATIO=0.55
GEARBEACON_STALE_AFTER_SECONDS=180

# Optional one-time legacy migration controls.
GEARBEACON_LEGACY_DATA_FILE=
GEARBEACON_SKIP_LEGACY_IMPORT=0

# Offline demo/test mode only.
MOCK_MODE=0
