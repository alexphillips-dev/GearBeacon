# GearBeacon V1.5 self-hosted configuration
PORT=8787
REGIONS=us
POLL_SECONDS=60

# Access modes:
# local   = loopback only; no password required by default
# private = LAN/VPN/server binding; owner authentication is mandatory
# proxy   = loopback/reverse-proxy deployment; owner authentication is mandatory
GEARBEACON_ACCESS_MODE=local
GEARBEACON_BIND_HOST=127.0.0.1
GEARBEACON_PUBLIC_BASE_URL=
GEARBEACON_ALLOWED_ORIGINS=
GEARBEACON_COOKIE_SECURE=0
GEARBEACON_SESSION_HOURS=168

# First-run private setup. Leave both blank to print a random one-time setup
# token in the server log. A password file is preferred to a plain env value.
GEARBEACON_SETUP_TOKEN=
GEARBEACON_OWNER_PASSWORD=
GEARBEACON_OWNER_PASSWORD_FILE=
GEARBEACON_RESET_OWNER_PASSWORD=0

# Optional server-side alert channels.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
DISCORD_WEBHOOK_URL=
GOTIFY_BASE_URL=
GOTIFY_TOKEN=
GEARBEACON_WEBHOOK_URL=
GEARBEACON_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Persistent SQLite and validated scheduled backups.
GEARBEACON_DATA_DIR=
GEARBEACON_BACKUP_INTERVAL_HOURS=24
GEARBEACON_BACKUP_RETENTION=10

# GitHub Releases powers Settings > Check for updates by default. Set empty to
# disable, or use a private/custom release JSON endpoint below.
GEARBEACON_GITHUB_RELEASE_API=https://api.github.com/repos/alexphillips-dev/GearBeacon/releases/latest
GEARBEACON_UPDATE_MANIFEST_URL=

# Monitor safety controls.
GEARBEACON_MIN_CATALOG_RATIO=0.55
GEARBEACON_STALE_AFTER_SECONDS=180

# Optional one-time legacy migration controls.
GEARBEACON_LEGACY_DATA_FILE=
GEARBEACON_SKIP_LEGACY_IMPORT=0

# Offline demo/test mode only.
MOCK_MODE=0

# Emergency compatibility escape hatch. Do not enable this for routine use.
GEARBEACON_ALLOW_INSECURE_REMOTE=0
